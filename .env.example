# TestRail API connection settings
TESTRAIL_URL=https://your-instance.testrail.io
TESTRAIL_USERNAME=your-email@example.com
TESTRAIL_API_KEY=your-api-key

# Required only for the remote HTTP server
MCP_AUTH_TOKEN=replace-with-a-long-random-token
HOST=0.0.0.0
PORT=3000
# Optional comma-separated Host header allowlist, for example:
# MCP_ALLOWED_HOSTS=testrail-mcp.example.com